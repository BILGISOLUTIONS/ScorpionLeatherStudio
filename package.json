{
  "name": "scorpion-leather-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sls/configurator",
    "build": "npm run build -w @sls/configurator",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run packages",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "budget": "node scripts/check-build-budget.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.9",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.0",
    "@vercel/node": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "nodemailer": "^7.0.0"
  }
}
