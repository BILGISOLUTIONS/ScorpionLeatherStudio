{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/configurator/dist",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "feature/*": false,
      "main": true
    }
  },
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  }
}
