{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@sls/product-schema": [
        "packages/product-schema/src/index.ts"
      ],
      "@sls/configurator-core": [
        "packages/configurator-core/src/index.ts"
      ],
      "@sls/pricing-engine": [
        "packages/pricing-engine/src/index.ts"
      ],
      "@sls/fitting-engine": [
        "packages/fitting-engine/src/index.ts"
      ],
      "@sls/shopify-adapter": [
        "packages/shopify-adapter/src/index.ts"
      ],
      "@sls/three-renderer": [
        "packages/three-renderer/src/index.tsx"
      ],
      "@sls/order-engine": [
        "packages/order-engine/src/index.ts"
      ],
      "@sls/material-library": [
        "packages/material-library/src/index.ts"
      ],
      "@sls/material-processor": [
        "packages/material-processor/src/index.ts"
      ],
      "@sls/material-promotion": [
        "packages/material-promotion/src/index.ts"
      ],
      "@sls/product-capture": [
        "packages/product-capture/src/index.ts"
      ],
      "@sls/product-asset-qa": [
        "packages/product-asset-qa/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "api/**/*.ts",
    "server/**/*.ts"
  ]
}
