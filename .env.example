# Scorpion Leather Studio — server-side order delivery
# Copy these names into Vercel Environment Variables or your production host.
# NEVER commit real passwords or access tokens.

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@scorpionwesternwear.com
SMTP_PASS=replace-in-host-environment-only
SMTP_FROM=orders@scorpionwesternwear.com

ORDER_DESTINATION_EMAIL=orders@scorpionwesternwear.com
ORDER_SEND_CUSTOMER_CONFIRMATION=true

# Optional comma-separated origins in addition to same-origin/localhost/Vercel previews.
# ORDER_ALLOWED_ORIGINS=https://scorpionwesternwear.com,https://www.scorpionwesternwear.com
ORDER_ALLOWED_ORIGINS=
